QMainWindow {
    background-color: #121212;
}

QLineEdit {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 2px solid #333333;
    border-radius: 8px;
    padding: 8px 15px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 2px solid #007ACC;
}

QPushButton {
    background-color: #007ACC;
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0098FF;
}

QFrame#ResultCard {
    background-color: #1E1E1E;
    border-radius: 10px;
    border: 1px solid #2D2D2D;
}